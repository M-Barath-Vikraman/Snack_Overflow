# PostgreSQL connection string from Railway
# Local development: Railway Public Database URL (e.g., postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway)
# Railway deployment: Railway Private Database URL (e.g., postgresql://postgres:password@postgres.railway.internal:5432/railway)
DATABASE_URL="postgresql://username:password@host:port/database"

# Secret key for JWT signing and verification (use a long, secure random string in production)
JWT_SECRET="super-secret-jwt-token-key-change-in-production"

# JWT Token Expiration duration (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN="7d"

# Application environment: 'development', 'production', or 'test'
NODE_ENV="development"

# Port on which the Express server listens
PORT=3000

# Allowed frontend origin for Cross-Origin Resource Sharing (CORS) and WebSockets
# Production: exact frontend domain (e.g. https://snack-overflow-frontend-production-xxxx.up.railway.app)
# Local development: e.g. http://localhost:5173 or http://localhost:8080 (supports comma-separated origins)
FRONTEND_ORIGIN="http://localhost:5173"

# Legacy fallback for CORS (kept for backward compatibility with FRONTEND_ORIGIN)
FRONTEND_URL="http://localhost:5173"
