# ==============================================================================
# Snack Overflow — Root Docker & Application Environment Configuration
# ==============================================================================
# Copy this file to '.env' at the project root before running Docker Compose:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL on Railway)
# ------------------------------------------------------------------------------
# Must be your Railway PostgreSQL public connection URL for local containers:
# Example: postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway
DATABASE_URL="postgresql://username:password@host:port/database"

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Configuration
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT tokens (HS256)
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key-min-32-chars"

# Expiration duration for user sessions (e.g., 7d, 24h, 1h)
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 3. Ports & Service Networking
# ------------------------------------------------------------------------------
# Port for the Express backend API and WebSocket server
BACKEND_PORT=3000

# Port for the React frontend application
FRONTEND_PORT=8080

# Allowed origins for Cross-Origin Resource Sharing (comma-separated if multiple)
FRONTEND_URL="http://localhost:8080,http://localhost:5173"

# ------------------------------------------------------------------------------
# 4. Frontend Runtime API & WebSocket Configuration (Browser-Accessible)
# ------------------------------------------------------------------------------
# Browser-accessible base URL for the backend REST APIs
API_BASE_URL="http://localhost:3000/api"

# Browser-accessible URL for the real-time WebSocket connection
WS_URL="ws://localhost:3000"
